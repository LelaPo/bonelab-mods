# mod.io API key (Games -> Bonelab)
MODIO_API_KEY=

# GitHub Personal Access Token (только для режима автора/создания паков, права gist)
GITHUB_TOKEN=

# Gist ID для общего реестра паков (registry.json)
MASTER_GIST_ID=

# Discord Webhook для трансляции прогресса скачивания (опционально)
DISCORD_WEBHOOK_URL=

# ID игры Bonelab на mod.io (по умолчанию 3809)
MODIO_GAME_ID=3809